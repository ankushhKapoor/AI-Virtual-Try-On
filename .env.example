# ==========================================
# AI Virtual Try-On - Environment Configuration
# ==========================================

# Database Connection (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=virtual_tryon

# Amazon Product Advertising API (PA-API) Configuration
AMAZON_ACCESS_TOKEN=""
AMAZON_PARTNER_TAG=""
AMAZON_MARKETPLACE="www.amazon.in"

# Oxylabs Amazon product/search access
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# JWT Authentication Configuration
# Generate a secure 32+ character key using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_super_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Service origins used by start.sh and the Vite development proxy.
# Keep these as local bindable URLs; no machine-specific LAN IP is needed.
BACKEND_URL=http://127.0.0.1:8000
MODEL_API_URL=http://127.0.0.1:8001
FRONTEND_PORT=5173

# Optional: only needed when browser code calls the APIs directly rather than
# through the same-origin Vite proxy. Add your current LAN frontend origin here.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persist Oxylabs product and search responses across backend restarts.
# Values are reused for 24 hours unless changed here.
BACKEND_CACHE_TTL_SECONDS=86400
